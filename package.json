{
  "name": "aristotle",
  "version": "2.0.1",
  "description": "⟁ Memory protection for OpenClaw agents. Your agent won't forget.",
  "main": "dist/plugin/index.js",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aristotle-agent/aristotle"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli/index.js",
